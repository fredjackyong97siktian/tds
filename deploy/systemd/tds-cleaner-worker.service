[Unit]
Description=TDS Daily Media Cleaner (04:00 Asia/Kuala_Lumpur)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/tds
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m app.workers.cleaner_worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
